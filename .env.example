# Copia este archivo a .env y ajusta los valores con tus credenciales reales.
# NUNCA subas el archivo .env al repositorio.

# Dialecto PostgreSQL: usa postgresql+psycopg:// (no postgresql://)
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/sistema-reclamos

# Clave para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia_esta_clave_por_una_generada_aleatoriamente

# Algoritmo de firma JWT
ALGORITHM=HS256

# Duración del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Para desarrollo local sin PostgreSQL puedes usar SQLite:
#   DATABASE_URL=sqlite:///./test.db

# ------------------------------------------------------------------
# Datos de prueba
# ------------------------------------------------------------------
# Carga usuarios con cada rol, normativa, cuadrillas, areas y reclamos:
#   python -m scripts.seed
#   python -m scripts.seed --reset   # borra lo anterior y recarga
#
# Usuario          documento    contrasena
# admin            10000001     clave123
# supervisor       10000002     clave123
# tecnico          10000003     clave123
# ciudadano        10000004     clave123

# ------------------------------------------------------------------
# Esquema
# ------------------------------------------------------------------
# Base.metadata.create_all() NO altera tablas que ya existen. Despues de
# anadir o cambiar una columna al ORM hay que aplicar la migracion:
#   python -m scripts.migrar_esquema
# Es idempotente y no borra datos.
